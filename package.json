{
  "name": "tank-duel",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "description": "手绘风反弹坦克对战游戏：单人、本地双人、局域网联机",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:map": "tsx scripts/maptest.ts",
    "lan": "npm run build && node server/lan-server.mjs",
    "serve": "node server/lan-server.mjs",
    "lantest": "tsx scripts/lantest.ts",
    "test:update": "tsx scripts/updatetest.ts",
    "manifest": "node scripts/gen-update-manifest.mjs",
    "build:single": "vite build --config vite.singlefile.config.ts && node scripts/build-singlefile.mjs",
    "verify:single": "tsx scripts/verify-singlefile.ts",
    "build:desktop": "npm run build && npm run build:single",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:desktop": "tsx scripts/desktop-test.ts",
    "verify": "npm run selftest && npm run lantest && npm run test:map && npm run test:update && npm run build && npm run test:desktop && npm run build:single && npm run verify:single",
    "maps": "tsx scripts/map-sheet.ts",
    "multitest": "tsx scripts/multitest.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/jsdom": "^30.0.0",
    "@types/ws": "^8.18.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.1.3",
    "phaser3spectorjs": "^0.0.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "Adamisatree",
    "email": "adamisatree@users.noreply.github.com"
  },
  "homepage": "https://github.com/Adamisatree/TankGame",
  "build": {
    "appId": "cn.adamisatree.tankgame",
    "productName": "TankGame",
    "copyright": "手绘坦克大作战",
    "asar": false,
    "directories": {
      "output": "release/desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "shared/**/*",
      "mirrors.json",
      "updates.json",
      "package.json",
      "!**/*.map",
      "!node_modules/phaser/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "坦克大作战",
      "artifactName": "TankGame-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "TankGame-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "TankGame-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
