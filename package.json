{
  "name": "tank-duel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A hand-drawn ricochet tank battle built with Phaser 3",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3",
    "phaser3spectorjs": "^0.0.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
